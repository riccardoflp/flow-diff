{
  "name": "flow-diff",
  "displayName": "Flow Diff",
  "description": "Side-by-side git diff viewer with center-gutter connectors",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "RiccardoFilippozzi",
  "repository": "https://github.com/riccardoflp/flow-diff",
  "engines": {
    "vscode": "^1.90.0"
  },
  "icon": "resources/icon/icon.png",
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "diff",
    "git",
    "side-by-side",
    "compare"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flowDiff.openDiff",
        "title": "Open Diff (Working Tree vs HEAD)",
        "category": "Flow Diff",
        "icon": "$(diff)"
      },
      {
        "command": "flowDiff.openDiffStaged",
        "title": "Open Diff (Index vs HEAD)",
        "category": "Flow Diff"
      },
      {
        "command": "flowDiff.compareWith",
        "title": "Compare with Branch or Revision…",
        "category": "Flow Diff",
        "icon": "$(git-compare)"
      },
      {
        "command": "flowDiff.nextChunk",
        "title": "Next Change",
        "category": "Flow Diff",
        "icon": "$(arrow-down)"
      },
      {
        "command": "flowDiff.prevChunk",
        "title": "Previous Change",
        "category": "Flow Diff",
        "icon": "$(arrow-up)"
      },
      {
        "command": "flowDiff.openFile",
        "title": "Open File",
        "category": "Flow Diff",
        "icon": "$(go-to-file)"
      },
      {
        "command": "flowDiff.stageFile",
        "title": "Stage File",
        "category": "Flow Diff",
        "icon": "$(add)"
      },
      {
        "command": "flowDiff.unstageFile",
        "title": "Unstage File",
        "category": "Flow Diff",
        "icon": "$(remove)"
      },
      {
        "command": "flowDiff.revertFile",
        "title": "Discard Changes (Revert File)",
        "category": "Flow Diff",
        "icon": "$(discard)"
      },
      {
        "command": "flowDiff.tree.stage",
        "title": "Stage",
        "category": "Flow Diff",
        "icon": "$(add)"
      },
      {
        "command": "flowDiff.tree.unstage",
        "title": "Unstage",
        "category": "Flow Diff",
        "icon": "$(remove)"
      },
      {
        "command": "flowDiff.tree.discard",
        "title": "Discard Changes",
        "category": "Flow Diff",
        "icon": "$(discard)"
      },
      {
        "command": "flowDiff.tree.openFile",
        "title": "Open File",
        "category": "Flow Diff",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "scm/resourceState/context": [
        {
          "command": "flowDiff.openDiff",
          "when": "scmProvider == git",
          "group": "navigation@1"
        },
        {
          "command": "flowDiff.openDiffStaged",
          "when": "scmProvider == git",
          "group": "navigation@2"
        },
        {
          "command": "flowDiff.compareWith",
          "when": "scmProvider == git",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "flowDiff.openDiff",
          "when": "config.git.enabled && resourceScheme == file && flowDiff.activeFileHasChanges",
          "group": "navigation@-1"
        },
        {
          "command": "flowDiff.openFile",
          "when": "activeWebviewPanelId == flowDiff.panel",
          "group": "navigation@1"
        },
        {
          "command": "flowDiff.prevChunk",
          "when": "activeWebviewPanelId == flowDiff.panel",
          "group": "navigation@2"
        },
        {
          "command": "flowDiff.nextChunk",
          "when": "activeWebviewPanelId == flowDiff.panel",
          "group": "navigation@3"
        },
        {
          "command": "flowDiff.stageFile",
          "when": "activeWebviewPanelId == flowDiff.panel && flowDiff.activeSide == worktree",
          "group": "navigation@4"
        },
        {
          "command": "flowDiff.revertFile",
          "when": "activeWebviewPanelId == flowDiff.panel && flowDiff.activeSide == worktree",
          "group": "navigation@5"
        },
        {
          "command": "flowDiff.unstageFile",
          "when": "activeWebviewPanelId == flowDiff.panel && flowDiff.activeSide == index",
          "group": "navigation@4"
        },
        {
          "command": "flowDiff.compareWith",
          "when": "activeWebviewPanelId == flowDiff.panel",
          "group": "1_compare"
        }
      ],
      "commandPalette": [
        {
          "command": "flowDiff.nextChunk",
          "when": "activeWebviewPanelId == flowDiff.panel"
        },
        {
          "command": "flowDiff.prevChunk",
          "when": "activeWebviewPanelId == flowDiff.panel"
        },
        {
          "command": "flowDiff.openFile",
          "when": "activeWebviewPanelId == flowDiff.panel"
        },
        {
          "command": "flowDiff.stageFile",
          "when": "activeWebviewPanelId == flowDiff.panel && flowDiff.activeSide == worktree"
        },
        {
          "command": "flowDiff.unstageFile",
          "when": "activeWebviewPanelId == flowDiff.panel && flowDiff.activeSide == index"
        },
        {
          "command": "flowDiff.revertFile",
          "when": "activeWebviewPanelId == flowDiff.panel && flowDiff.activeSide == worktree"
        },
        {
          "command": "flowDiff.tree.stage",
          "when": "false"
        },
        {
          "command": "flowDiff.tree.unstage",
          "when": "false"
        },
        {
          "command": "flowDiff.tree.discard",
          "when": "false"
        },
        {
          "command": "flowDiff.tree.openFile",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "flowDiff.compareWith",
          "when": "config.git.enabled && !explorerResourceIsFolder",
          "group": "3_compare@9"
        }
      ],
      "editor/title/context": [
        {
          "command": "flowDiff.compareWith",
          "when": "config.git.enabled && resourceScheme == file",
          "group": "3_compare@9"
        }
      ],
      "view/item/context": [
        {
          "command": "flowDiff.tree.openFile",
          "when": "view == flowDiff.localChanges && viewItem =~ /^file-/",
          "group": "inline@1"
        },
        {
          "command": "flowDiff.tree.discard",
          "when": "view == flowDiff.localChanges && viewItem =~ /^(file|dir|group)-(changes|untracked)$/",
          "group": "inline@2"
        },
        {
          "command": "flowDiff.tree.stage",
          "when": "view == flowDiff.localChanges && viewItem =~ /^(file|dir|group)-(changes|untracked)$/",
          "group": "inline@3"
        },
        {
          "command": "flowDiff.tree.unstage",
          "when": "view == flowDiff.localChanges && viewItem =~ /^(file|dir|group)-staged$/",
          "group": "inline@3"
        },
        {
          "command": "flowDiff.tree.openFile",
          "when": "view == flowDiff.localChanges && viewItem =~ /^file-/",
          "group": "1_open@1"
        },
        {
          "command": "flowDiff.compareWith",
          "when": "view == flowDiff.localChanges && viewItem =~ /^file-/",
          "group": "1_open@2"
        },
        {
          "command": "flowDiff.tree.stage",
          "when": "view == flowDiff.localChanges && viewItem =~ /^(file|dir|group)-(changes|untracked)$/",
          "group": "2_git@1"
        },
        {
          "command": "flowDiff.tree.unstage",
          "when": "view == flowDiff.localChanges && viewItem =~ /^(file|dir|group)-staged$/",
          "group": "2_git@1"
        },
        {
          "command": "flowDiff.tree.discard",
          "when": "view == flowDiff.localChanges && viewItem =~ /^(file|dir|group)-(changes|untracked)$/",
          "group": "2_git@2"
        }
      ]
    },
    "configuration": {
      "title": "Flow Diff",
      "properties": {
        "flowDiff.interceptGitOpenChange": {
          "type": "boolean",
          "default": true,
          "description": "Use Flow Diff instead of VS Code's built-in diff editor for git diffs opened from the Source Control panel or the commit graph."
        },
        "flowDiff.collapseUnchanged": {
          "type": "boolean",
          "default": true,
          "description": "Collapse long runs of unchanged lines (keeping 3 lines of context around each change). Toggle per panel from the floating toolbar."
        }
      }
    },
    "keybindings": [
      {
        "command": "flowDiff.nextChunk",
        "key": "f7",
        "when": "activeWebviewPanelId == flowDiff.panel"
      },
      {
        "command": "flowDiff.prevChunk",
        "key": "shift+f7",
        "when": "activeWebviewPanelId == flowDiff.panel"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "flowDiff.localChanges",
          "name": "Local Changes",
          "when": "config.git.enabled"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && tsc -p src/webview && npm run bundle:webview",
    "bundle:webview": "node -e \"require('fs').rmSync('out/webview',{recursive:true,force:true})\" && esbuild src/webview/main.ts --bundle --outdir=out/webview --format=esm --splitting --chunk-names=chunks/[name]-[hash] --loader:.ttf=file --sourcemap && esbuild node_modules/monaco-editor/esm/vs/editor/editor.worker.js --bundle --format=iife --outfile=out/webview/editor.worker.js --minify",
    "watch": "tsc -watch -p ./",
    "watch:webview": "esbuild src/webview/main.ts --bundle --outdir=out/webview --format=esm --splitting --chunk-names=chunks/[name]-[hash] --loader:.ttf=file --sourcemap --watch",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "package": "vsce package"
  },
  "dependencies": {
    "diff": "^7.0.0"
  },
  "devDependencies": {
    "@shikijs/engine-javascript": "^4.2.0",
    "@shikijs/langs": "^4.2.0",
    "@shikijs/monaco": "^4.2.0",
    "@shikijs/themes": "^4.2.0",
    "@types/diff": "^7.0.0",
    "@types/node": "20.x",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "monaco-editor": "^0.55.1",
    "ovsx": "^1.2.0",
    "shiki": "^4.2.0",
    "typescript": "^5.4.0"
  }
}
